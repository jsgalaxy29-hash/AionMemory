@using Aion.AppHost.Services.Rendering
@using Microsoft.AspNetCore.Components.Forms

<InputCheckbox class="input" data-field-renderer="checkbox" Value="@CurrentValue" ValueChanged="OnValueChanged" ValueExpression="() => CurrentValue" disabled="@Disabled" />

@code {
    [Parameter, EditorRequired] public FormFieldRenderModel Field { get; set; } = default!;
    [Parameter] public object? Value { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public EventCallback<object?> ValueChanged { get; set; }

    private bool CurrentValue => FieldValueConverters.ToBoolValue(Value);

    private Task OnValueChanged(bool value) => ValueChanged.InvokeAsync(value);
}
