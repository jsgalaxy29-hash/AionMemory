@using Aion.AppHost.Services.Rendering
@using Microsoft.AspNetCore.Components.Forms

<InputTextArea class="input" data-field-renderer="text-area" Value="@CurrentValue" ValueChanged="OnValueChanged" ValueExpression="() => CurrentValue" disabled="@Disabled" />

@code {
    [Parameter, EditorRequired] public FormFieldRenderModel Field { get; set; } = default!;
    [Parameter] public object? Value { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public EventCallback<object?> ValueChanged { get; set; }

    private string? CurrentValue => FieldValueConverters.ToStringValue(Value);

    private Task OnValueChanged(string? value) => ValueChanged.InvokeAsync(value);
}
